# PlantDoc environment contract.
# Copy to .env and fill in real values. Never commit .env.
#
# Public client values (safe to expose to the browser via Vite):
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_PROJECT_NAME=PlantDoc
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
#
# Server-only secret used by scripts/appwrite/*. NEVER prefix this with VITE_
# (a VITE_ prefix would bundle the key into browser code).
# Non-VITE overrides (APPWRITE_PROJECT_ID, APPWRITE_ENDPOINT, APPWRITE_PROJECT_NAME)
# take precedence over the VITE_ values for the admin scripts when present.
APPWRITE_API_KEY=your-server-api-key

# Server-only Gemini preview key for AI insights. NEVER prefix this with VITE_.
# Production Workers must also receive this as a Cloudflare secret:
# npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
